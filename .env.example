# =============================================================================
#  Crée ton drone du futur — configuration
#  Copier ce fichier en .env.local puis compléter. Ne JAMAIS committer .env.local.
#  Toutes les variables sont lues côté serveur ; aucune n'est exposée au navigateur
#  (seules des valeurs non secrètes comme les durées sont transmises à la page).
# =============================================================================

# --- Génération d'image -------------------------------------------------------
# Token Replicate (secret, serveur uniquement). Sans token, l'app tourne en mode « mock ».
REPLICATE_API_TOKEN=
# replicate | mock  (par défaut : replicate si un token est présent, sinon mock)
GENERATION_PROVIDER=
# Modèle : "owner/name" ou "owner/name:version". Préconfigurés :
#   prunaai/p-image-edit (défaut, très rapide) · black-forest-labs/flux-kontext-pro
#   prunaai/flux-kontext-dev · google/nano-banana
REPLICATE_MODEL=prunaai/p-image-edit
# match_input_image | 4:3 | 16:9 | 1:1 | …
REPLICATE_ASPECT_RATIO=match_input_image
# JSON fusionné dans l'input du modèle, ex. {"turbo":true,"seed":42}
REPLICATE_EXTRA_INPUT=
# Modèle non préconfiguré : nom du champ image et format tableau (true/false)
REPLICATE_IMAGE_FIELD=input_image
REPLICATE_IMAGE_FIELD_IS_ARRAY=false
# Nouvelles tentatives automatiques côté serveur (0–3) et rythme de polling
REPLICATE_MAX_RETRIES=1
REPLICATE_POLL_INTERVAL_MS=500
# Timeout technique total d'une génération (ms) → écran « Oups ! »
GENERATION_TIMEOUT_MS=60000
# Délai simulé du mode mock (ms)
MOCK_DELAY_MS=5000

# --- Expérience ---------------------------------------------------------------
# Durée minimale de la mini-scène sous-marine avant la remontée (ms)
SCENE_MIN_DURATION_MS=6500
# Retour automatique à l'accueil après inactivité sur l'écran final (ms)
RESULT_IDLE_TIMEOUT_MS=120000
# Retour automatique à l'accueil si un parcours est abandonné (ms)
QUESTION_IDLE_TIMEOUT_MS=300000
# Afficher les caractéristiques sous le drone (true/false)
RESULT_SHOW_SUBTITLE=true
# Nom de l'événement (accueil, bandeau, image finale, e-mail). Défaut : « Journée des Familles 2026 ».
EVENT_NAME=

# --- Caméra -------------------------------------------------------------------
# Miroir de la prévisualisation (la photo envoyée n'est jamais en miroir)
CAMERA_MIRROR=false
# Rotation logicielle si la webcam est montée de travers : 0 | 90 | 180 | 270
CAMERA_ROTATION=0
# Compte à rebours avant la photo (s, 0 = immédiat)
CAMERA_COUNTDOWN=3
# Choisir une webcam précise par (partie de) son nom, ex. "Logitech"
CAMERA_DEVICE_LABEL=
# Taille max (px, grand côté) et ratio de la capture envoyée au modèle
CAPTURE_MAX_SIZE=1024
CAPTURE_ASPECT=4:3

# --- Récupération de l'image : QR code ------------------------------------------
# local | r2 | supabase | vercel-blob | none
STORAGE_PROVIDER=local
# Durée de validité du lien et de conservation des images (h)
SHARE_TTL_HOURS=48
# URL publique de l'app, joignable par le téléphone du parent (fournisseur « local »).
# Ex. http://192.168.1.20:3000 (même Wi-Fi) ou https://mon-tunnel.example.com
PUBLIC_BASE_URL=
LOCAL_STORAGE_DIR=./storage

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Domaine public du bucket (r2.dev ou personnalisé). Vide = URL pré-signée expirante.
R2_PUBLIC_URL=

# Supabase Storage (bucket privé + URL signée)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=drones

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# --- E-mail (option secondaire) -------------------------------------------------
# none (bouton masqué) | log (simulation) | resend | sendgrid | smtp
EMAIL_PROVIDER=none
EMAIL_FROM=Drone du futur <drone@example.com>
RESEND_API_KEY=
SENDGRID_API_KEY=
# ex. smtps://utilisateur:motdepasse@smtp.example.com:465
SMTP_URL=

# --- Sécurité / limites -----------------------------------------------------------
MAX_UPLOAD_BYTES=4194304
RATE_LIMIT_GENERATE_PER_MINUTE=12
RATE_LIMIT_EMAIL_PER_MINUTE=6
# Conservation en mémoire des générations (croquis effacé dès la fin de la génération)
SESSION_RETENTION_MINUTES=60

# --- Développement ----------------------------------------------------------------
# Outils de test (panneau 🛠, /api/stats). Par défaut : actif en dev, inactif en production.
DEV_TOOLS=false
